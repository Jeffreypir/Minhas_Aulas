\section*{Gabarito Comentado}

\begin{enumerate}
    \item \textbf{D) 6} \\ 
    \textit{Comentário:} São 3 letras distintas, logo é uma permutação simples: $3! = 3 \cdot 2 \cdot 1 = 6$.

    \item \textbf{E) 24} \\ 
    \textit{Comentário:} Organizar 4 pessoas em fila corresponde a uma permutação simples: $4! = 24$.

    \item \textbf{B) 6} \\ 
    \textit{Comentário:} Na palavra KARINA  há repetição de letras (2 M e 2 A). Logo: $\frac{6!}{2!} = \frac{24}{4} = 6$.

    \item \textbf{C) 20} \\ 
    \textit{Comentário:} Arranjo de 5 elementos tomados 2 a 2: $A_{5,2} = \frac{5!}{(5-2)!} = \frac{120}{6} = 20$.

    \item \textbf{C) 10} \\ 
    \textit{Comentário:} Combinação de 5 elementos tomados 2 a 2: $C_{5,2} = \frac{5!}{2!\,3!} = 10$.

    \item \textbf{C) Combinação} \\ 
    \textit{Comentário:} A combinação é o caso em que a ordem não importa; nos arranjos e permutações, a ordem importa.

    \item \textbf{C) 120} \\ 
    \textit{Comentário:} Arranjo de 6 elementos tomados 3 a 3: $A_{6,3} = \frac{6!}{(6-3)!} = \frac{720}{6} = 120$.

    \item \textbf{D) 20} \\ 
    \textit{Comentário:} Combinação de 6 elementos tomados 3 a 3: $C_{6,3} = \frac{6!}{3!\,3!} = 20$.

    \item \textbf{A) 24} \\ 
    \textit{Comentário:} Permutação circular de 5 pessoas: $(n-1)! = (5-1)! = 4! = 24$.

    \item \textbf{C) 6} \\ 
    \textit{Comentário:} Combinação de 4 elementos tomados 2 a 2: $C_{4,2} = \frac{4!}{2!\,2!} = 6$.
\end{enumerate}

