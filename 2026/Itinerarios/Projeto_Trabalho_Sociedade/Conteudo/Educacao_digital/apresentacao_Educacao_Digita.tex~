\section{Capítulo 1 — Educação Digital}

\begin{frame}{Educação Digital}
\begin{itemize}
  \item Uso consciente, crítico e ético das tecnologias digitais
  \item Vai além do uso de ferramentas
  \item Envolve cidadania, autonomia e responsabilidade
\end{itemize}
\end{frame}

\begin{frame}{Desigualdades Digitais}
\begin{itemize}
  \item Acesso desigual à internet e a dispositivos
  \item Diferenças regionais, sociais e econômicas
  \item Impactos na educação e no trabalho
\end{itemize}
\end{frame}

\begin{frame}{Inclusão e Exclusão Digital}
\begin{block}{Inclusão Digital}
Garantia de acesso, uso e participação no mundo digital
\end{block}

\begin{block}{Exclusão Digital}
Falta de acesso, conhecimento ou condições de uso
\end{block}
\end{frame}

\begin{frame}{Pilares da Educação Digital}
\begin{itemize}
  \item Acesso às tecnologias
  \item Uso crítico e ético
  \item Produção de conteúdo
  \item Participação cidadã
\end{itemize}
\end{frame}

\begin{frame}{Competências Digitais}
\begin{itemize}
  \item Saber usar tecnologias digitais
  \item Avaliar informações e fontes
  \item Comunicar-se e colaborar online
  \item Criar conteúdos digitais
\end{itemize}
\end{frame}

\begin{frame}{Quais são as Competências Digitais?}
\begin{enumerate}
  \item Informação e dados
  \item Comunicação e colaboração
