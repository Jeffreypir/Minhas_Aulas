\section*{1. Números de 3 algarismos distintos com os dígitos 1, 2, 3, 4, 5}

\textbf{Identificação:}  
- Ordem importa (312 $\neq$ 132)  
- Sem repetição  

\textbf{Resolução passo a passo:}  
\begin{itemize}
    \item 1º algarismo: 5 opções  
    \item 2º algarismo: 4 opções (não pode repetir o 1º)  
    \item 3º algarismo: 3 opções (não pode repetir os dois anteriores)
\end{itemize}

\[
5 \times 4 \times 3 = 60
\]

\textbf{Resposta:} 60 números

\section*{2. Escolha de 5 questões entre 8}

\textbf{Identificação:}  
- Ordem não importa  
- Sem repetição  

\textbf{Resolução:}  
Escolher 5 questões = escolher 3 que \textit{não} serão respondidas.

\[
\text{Total de formas} = \frac{8 \times 7 \times 6}{3 \times 2 \times 1} = 56
\]

\textbf{Resposta:} 56 maneiras

\section*{3. Anagramas da palavra “MATEMÁTICA”}

\textbf{Identificação:}  
- Ordem importa  
- Há repetição de letras: A=3, M=2, T=2  

\textbf{Resolução:}  
\[
\text{Total} = \frac{10!}{3! \times 2! \times 2!} = 151\,200
\]

\textbf{Resposta:} 151\,200 anagramas

\section*{4. Comissões em sala com 10 homens e 8 mulheres}

\textbf{(a) Qualquer pessoa}  
\[
\text{Total} = \frac{18 \times 17 \times 16 \times 15}{4 \times 3 \times 2 \times 1} = 3\,060
\]

\textbf{(b) 2 homens e 2 mulheres}  
\[
\text{Homens} = \frac{10 \times 9}{2} = 45, \quad \text{Mulheres} = \frac{8 \times 7}{2} = 28
\]  
\[
\text{Total} = 45 \times 28 = 1\,260
\]

\textbf{(c) Pelo menos 1 mulher}  
\[
\text{Total} = 3\,060 - 210 = 2\,850
\]

\section*{5. Números pares de 4 algarismos distintos com dígitos 1--6}

\textbf{Identificação:}  
- Ordem importa  
- Sem repetição  
