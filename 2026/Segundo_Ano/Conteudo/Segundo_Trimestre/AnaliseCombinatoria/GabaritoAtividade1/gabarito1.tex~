\textbf{Resolução:}  
\begin{itemize}
    \item Último dígito: 3 opções  
    \item Primeiro dígito: 5 opções  
    \item Segundo dígito: 4 opções  
    \item Terceiro dígito: 3 opções
\end{itemize}

\[
3 \times 5 \times 4 \times 3 = 180
\]

\textbf{Resposta:} 180 números pares

