\section*{11. Números ímpares de 4 dígitos distintos entre 1000 e 5000}

\textbf{Resolução por casos:}  
\begin{itemize}
    \item Milhar ímpar (1 ou 3): 2 opções  
        \quad Unidade ímpar diferente do milhar: 4  
        \quad Casas do meio: 8 × 7 = 56  
        \quad Total: 2 × 224 = 448
    \item Milhar par (2 ou 4): 2 opções  
        \quad Unidade ímpar: 5 opções  
        \quad Casas do meio: 8 × 7 = 56  
        \quad Total: 2 × 280 = 560
\end{itemize}

\[
\text{Total} = 448 + 560 = 1\,008
\]

