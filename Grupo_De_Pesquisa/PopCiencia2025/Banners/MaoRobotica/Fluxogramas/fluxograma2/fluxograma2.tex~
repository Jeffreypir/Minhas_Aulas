\begin{tikzpicture}[
  node distance=10mm and 15mm,
  box/.style={draw, rounded corners, minimum width=40mm, minimum height=8mm, align=center, fill=#1!30, text=#1!900},
  io/.style={draw, trapezium, trapezium left angle=70, trapezium right angle=110, minimum width=40mm, minimum height=8mm, align=center, fill=#1!30, text=#1!900},
