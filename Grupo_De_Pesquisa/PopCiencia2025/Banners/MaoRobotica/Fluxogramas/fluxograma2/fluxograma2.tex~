\node[box=orange, below=of detect] (process) {3. Processamento\\(extração de gestos)};
\node[box=purple, below=of process] (map) {4. Mapeamento\\(gesto → ângulo dos servos)};
\node[box=red, below=of map] (send) {5. Envio serial\\(Python → Arduino)};
\node[box=brown, below=of send] (act) {6. Atuação\\(servomotores)};
\node[box=violet, right=of process, xshift=35mm] (visual) {Feedback visual\\(GUI / vídeo)};

% Arrows
\draw[arrow=black] (cam) -- (detect);
\draw[arrow=black] (detect) -- (process);
\draw[arrow=black] (process) -- (map);
\draw[arrow=black] (map) -- (send);
\draw[arrow=black] (send) -- (act);
\draw[arrow=black] (process) -- (visual);
\draw[arrow=black] (visual) |- (send);

% Optional annotations
\node[below=6mm of act, align=center] (note) {Observações:\\iluminação e taxa de captura afetam precisão.};

